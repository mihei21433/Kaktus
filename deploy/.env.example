# Скопируйте в .env:  cp .env.example .env  — и заполните.

# Домен сервера, A-запись которого указывает на IP вашего VPS
API_DOMAIN=api.vectorfamily.kz

# Пароль базы данных — длинная случайная строка
POSTGRES_PASSWORD=

# Ключ подписи входа, не короче 32 символов: openssl rand -hex 32
JWT_SECRET=

# SMS через Mobizon. Пока ключа нет — оставьте console (коды будут в журнале сервера)
SMS_PROVIDER=mobizon
MOBIZON_API_KEY=
MOBIZON_API_URL=https://api.mobizon.kz
# Имя отправителя (альфа-имя), если зарегистрировано в Mobizon
SMS_SENDER=

# Почта через SMTP вашего почтового сервиса
EMAIL_PROVIDER=smtp
SMTP_URL=smtps://логин:пароль@smtp.example.kz:465
EMAIL_FROM=Кактус <no-reply@vectorfamily.kz>

PUSH_ENABLED=true
