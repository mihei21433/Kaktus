{$API_DOMAIN} {
	encode gzip
	reverse_proxy api:3000
}

# Веб-версия приложения (для iPhone до выхода в TestFlight и для компьютера).
# Файлы кладёт auto-update.sh из ветки production-web; current — ссылка на последнюю версию.
{$APP_DOMAIN} {
	root * /srv/web/current
	encode gzip
	header /_expo/static/* Cache-Control "public, max-age=31536000, immutable"
	header /index.html Cache-Control "no-cache"
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}
	try_files {path} /index.html
	file_server
}
