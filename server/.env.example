# Скопируйте в .env и заполните. Для локального теста ничего задавать не нужно.

# production — боевой режим (обязательны JWT_SECRET и настоящая отправка кодов)
NODE_ENV=development
PORT=3000

# Без DATABASE_URL используется встроенная база в папке ./data
# DATABASE_URL=postgres://kaktus:пароль@localhost:5432/kaktus

# Длинная случайная строка, не короче 32 символов
# JWT_SECRET=

# Коды входа: console — в журнал сервера; mobizon — настоящие SMS
SMS_PROVIDER=console
# MOBIZON_API_KEY=
# MOBIZON_API_URL=https://api.mobizon.kz
# SMS_SENDER=Kaktus

# console — в журнал сервера; smtp — настоящие письма
EMAIL_PROVIDER=console
# SMTP_URL=smtps://логин:пароль@smtp.mail.kz:465
# EMAIL_FROM=Кактус <no-reply@kaktus.kz>

# Пуш-уведомления через сервис Expo
PUSH_ENABLED=false
